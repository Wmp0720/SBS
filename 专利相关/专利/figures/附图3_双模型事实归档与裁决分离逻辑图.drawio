          <mxGeometry x="50" y="70" width="500" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="fact_title" value="事实归档层（第一、二、三阶段）" style="text;html=1;strokeColor=none;fillColor=#82b366;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="150" y="80" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- 模型A归档 -->
        <mxCell id="modelA_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="modelA_title" value="模型A 结构化归档" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="125" width="160" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="modelA_json" value="{&#xa;  &quot;样本ID&quot;: &quot;sample_001&quot;,&#xa;  &quot;主要问题标签&quot;: &quot;13无问题&quot;,&#xa;  &quot;核心优势&quot;: &quot;结构化呈现&quot;,&#xa;  &quot;严重度等级&quot;: 1,&#xa;  &quot;优势等级&quot;: 5,&#xa;  &quot;合格率&quot;: &quot;优质&quot;&#xa;}" style="text;html=1;strokeColor=#82b366;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="155" width="200" height="135" as="geometry"/>
        </mxCell>

        <!-- 模型B归档 -->
        <mxCell id="modelB_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="modelB_title" value="模型B 结构化归档" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="125" width="160" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="modelB_json" value="{&#xa;  &quot;样本ID&quot;: &quot;sample_002&quot;,&#xa;  &quot;主要问题标签&quot;: &quot;5简略_2&quot;,&#xa;  &quot;核心优势&quot;: &quot;无&quot;,&#xa;  &quot;严重度等级&quot;: 2,&#xa;  &quot;优势等级&quot;: 1,&#xa;  &quot;合格率&quot;: &quot;合格&quot;&#xa;}" style="text;html=1;strokeColor=#d79b00;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="155" width="200" height="135" as="geometry"/>
        </mxCell>

        <!-- 对比结果 -->
        <mxCell id="compare_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="compare_title" value="结构化对比结果" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="325" width="160" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="compare_json" value="{&#xa;  &quot;对比ID&quot;: &quot;compare_001&quot;,&#xa;  &quot;合格率差异&quot;: &quot;模型A(优质) &gt; 模型B(合格)&quot;,&#xa;  &quot;失败触发器对比&quot;: &quot;双方均未命中&quot;,&#xa;  &quot;胜利模式对比&quot;: &quot;模型A具备5级优势，模型B无优势&quot;,&#xa;  &quot;严重度差异&quot;: &quot;模型A(1级) &lt; 模型B(2级)&quot;,&#xa;  &quot;核心优劣势结论&quot;: &quot;模型A在合格率、优势、严重度均优于模型B&quot;&#xa;}" style="text;html=1;strokeColor=#6c8ebf;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="355" width="440" height="135" as="geometry"/>
        </mxCell>

        <!-- 隔离线 -->
        <mxCell id="separator" value="" style="endArrow=none;dashed=1;html=1;dashPattern=8 8;strokeWidth=3;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="580" y="520" as="sourcePoint"/>
            <mxPoint x="580" y="70" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="separator_label" value="隔离边界" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="545" y="280" width="70" height="25" as="geometry"/>
        </mxCell>

        <!-- 右侧：裁决推理层 -->
        <mxCell id="decision_area" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="530" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="decision_title" value="裁决推理层（第四阶段）" style="text;html=1;strokeColor=none;fillColor=#b85450;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="250" height="30" as="geometry"/>
        </mxCell>

        <!-- 输入：仅归档事实 -->
        <mxCell id="input_fact" value="输入：仅读取结构化归档事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="370" height="30" as="geometry"/>
        </mxCell>

        <!-- 裁决规则 -->
        <mxCell id="rule_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="490" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="rule_title" value="多维度裁决规则（按优先级执行）" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="165" width="250" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="rule1" value="P1: 致命错误裁定 → 严重度等级5级者直接判负" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="195" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rule2" value="P2: 优势等级裁定 → 优势等级总和高者判胜" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="225" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rule3" value="P3: 合格率裁定 → 优质&gt;合格&gt;不合格&gt;弱智" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="255" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rule4" value="P4: 严重度对比 → 严重度等级更低者判胜" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="285" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rule5" value="P5: 问题数量对比 → 主要问题标签数量更少者判胜" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="315" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rule6" value="P6: 平局裁定 → 上述维度均无法区分时判&quot;平&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="345" width="450" height="25" as="geometry"/>
        </mxCell>

        <!-- 裁决结果 -->
        <mxCell id="result_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="380" width="490" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="result_title" value="最终裁决输出" style="text;html=1;strokeColor=none;fillColor=#9673a6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="800" y="385" width="170" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="result_content" value="裁决结果：模型A 胜&#xa;&#xa;裁判说明：基于对比评估结果，模型A合格率(优质)优于模型B(合格)，&#xa;且模型A具备5级核心优势(结构化呈现)，模型B无优势，严重度等级&#xa;模型A(1级)低于模型B(2级)，综合判定模型A胜。" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="655" y="415" width="460" height="75" as="geometry"/>
        </mxCell>

        <!-- 箭头：事实到裁决 -->
        <mxCell id="arrow_fact_decision" value="" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="540" y="295" as="sourcePoint"/>
            <mxPoint x="620" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow_label" value="仅传递&#xa;归档事实" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="555" y="260" width="50" height="30" as="geometry"/>
        </mxCell>

        <!-- 关键约束标注 -->
        <mxCell id="constraint1" value="不访问原始输出" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="505" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="constraint2" value="避免表面信息干扰" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="505" width="130" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="constraint3" value="确保结果可溯源" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="505" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- 创新点标注 -->
        <mxCell id="innovation" value="创新点3：事实与裁决分离机制 - 裁决层仅基于结构化事实判定，不访问原始输出" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="535" width="600" height="25" as="geometry"/>
